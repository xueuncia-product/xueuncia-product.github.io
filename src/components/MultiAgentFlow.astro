---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const roles = [
  { id: 'dispatch', phase: '01 · 调度', title: '确定目标与边界', caption: '拆成可以独立完成的任务', work: '先说明要解决的问题，再划分输入、职责和允许修改的范围。', result: '每个任务都有负责人、输出位置、验收条件和退出条件。', evidence: '任务清单能说明谁负责什么，哪些决定仍需统一确认。' },
  { id: 'sources', phase: '02 · 并行任务', title: '资料梳理', caption: '找出处，分清事实与判断', work: '读取材料，提取与目标有关的事实，区分原文、推断和待核验信息。', result: '一份有来源、标明公开范围的草稿或要点表。', evidence: '结论可以追溯到原始材料，公开版本没有内部信息。', link: '/ai-learning/', linkLabel: '看公开学习材料 →' },
  { id: 'build', phase: '02 · 并行任务', title: '页面实现', caption: '把内容与交互落到页面', work: '在约定范围内完成页面结构、视觉与交互，复用已有组件和素材。', result: '可以打开、点击和阅读的页面，以及对应的改动。', evidence: '用实际页面确认导航、主题、手机布局与资源加载。', link: '/contact/', linkLabel: '打开联系页示例 →' },
  { id: 'check', phase: '02 · 并行任务', title: '检查验证', caption: '先写清楚怎样算完成', work: '对照需求准备必要检查，检查实现结果与资料依据，记录失败和限制。', result: '可复现的检查结果，明确通过项、未通过项和未检查项。', evidence: '检查应覆盖关键行为与数据边界，不能只看一张截图。' },
  { id: 'merge', phase: '03 · 复核归并', title: '交付一份一致结果', caption: '核对依赖，再统一收尾', work: '把各任务产物放在一起，对照共同目标复核内容、交互和未决事项。', result: '一份能审查、能使用的最终交付，附验证结论与实际限制。', evidence: '交付物相互一致，能沿着来源和检查结果回看。', link: '/works/', linkLabel: '回作品展示 →' },
];
---
<section class="agent-flow" data-agent-flow aria-label="多 Agent 协作流程演示">
  <p class="flow-label">流程演示 · 不代表实时任务进度</p>
  <div class="flow-map">
    <svg class="flow-connectors" viewBox="0 0 1000 360" preserveAspectRatio="none" aria-hidden="true"><path d="M230 180 H315 V68 H415 M315 180 H415 M315 180 V292 H415 M585 68 H685 V180 H770 M585 180 H770 M585 292 H685 V180" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    <button class="flow-node" type="button" data-role={roles[0].id} aria-controls={`flow-${roles[0].id}`} aria-pressed="true"><small>{roles[0].phase}</small><strong>{roles[0].title}</strong><span>{roles[0].caption}</span></button>
    <div class="parallel-nodes" aria-label="三个并行任务">
      {roles.slice(1, 4).map((role) => <button class="flow-node" type="button" data-role={role.id} aria-controls={`flow-${role.id}`} aria-pressed="false"><small>{role.phase}</small><strong>{role.title}</strong><span>{role.caption}</span></button>)}
    </div>
    <button class="flow-node" type="button" data-role={roles[4].id} aria-controls={`flow-${roles[4].id}`} aria-pressed="false"><small>{roles[4].phase}</small><strong>{roles[4].title}</strong><span>{roles[4].caption}</span></button>
  </div>
  <div class="flow-details" aria-live="polite" aria-atomic="true">
    {roles.map((role, i) => <section id={`flow-${role.id}`} data-role-panel={role.id} hidden={i !== 0}>
      <p class="eyebrow">角色分工</p><h2>{role.title}</h2>
      <dl><div><dt>工作内容</dt><dd>{role.work}</dd></div><div><dt>交付结果</dt><dd>{role.result}</dd></div><div><dt>复核证据</dt><dd>{role.evidence}</dd></div></dl>
      {role.link && <a class="flow-evidence" href={`${base}${role.link}`}>{role.linkLabel}</a>}
    </section>)}
  </div>
  <p class="flow-hint">点击角色查看分工。这里展示协作方式，交付结果与证据说明是流程示例。</p>
</section>

<script>
  for (const flow of document.querySelectorAll('[data-agent-flow]')) {
    const buttons = flow.querySelectorAll('[data-role]'), panels = flow.querySelectorAll('[data-role-panel]');
    for (const button of buttons) button.addEventListener('click', () => {
      for (const item of buttons) item.setAttribute('aria-pressed', String(item === button));
      for (const panel of panels) panel.toggleAttribute('hidden', panel.getAttribute('data-role-panel') !== button.getAttribute('data-role'));
    });
  }
</script>

<style>
  .flow-label { display: inline-block; margin: 0; padding: 7px 12px; border: 1px solid var(--line); border-radius: 99px; color: var(--mute); font-size: 13px; }
  .flow-map { position: relative; display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 56px; align-items: center; padding: 36px 0; }
  .flow-connectors { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--blue); opacity: .35; pointer-events: none; }
  .flow-node { position: relative; display: flex; flex-direction: column; gap: 9px; width: 100%; border: 1px solid var(--line); border-radius: 16px; padding: 21px 19px; background: var(--chip); color: var(--ink); text-align: left; transition: border-color .2s, transform .2s; }
  .flow-node small { font-size: 12px; color: var(--mute); }.flow-node strong { font-size: 20px; font-weight: 600; line-height: 1.5; }.flow-node span { color: var(--mute); font-size: 14px; line-height: 1.6; }
  .flow-node:hover { transform: translateY(-2px); }.flow-node[aria-pressed=true] { border-color: var(--blue); box-shadow: inset 0 0 0 1px var(--blue); }
  .parallel-nodes { display: grid; gap: 12px; }
  .flow-details { background: var(--chip); border: 1px solid var(--line); border-radius: 18px; padding: 30px; }
  .flow-details .eyebrow { margin: 0; }.flow-details h2 { font-size: 27px; font-weight: 600; margin: 12px 0 25px; line-height: 1.5; }
  .flow-details dl { margin: 0; display: grid; gap: 19px; }.flow-details dl > div { display: grid; grid-template-columns: 88px 1fr; gap: 18px; }
  .flow-details dt { color: var(--mute); font-size: 14px; line-height: 1.9; }.flow-details dd { margin: 0; font-size: 17px; line-height: 1.9; }
  .flow-evidence { display: inline-block; margin-top: 24px; font-size: 15px; text-decoration: none; }
  .flow-hint { color: var(--mute); font-size: 13px; line-height: 1.8; margin: 18px 0 0; }
  @media(max-width:760px) {
    .flow-map { grid-template-columns: 1fr; gap: 16px; padding: 25px 0; }.flow-connectors { display: none; }
    .parallel-nodes { border-left: 2px solid var(--line); padding-left: 16px; }.flow-node { padding: 18px; }
    .flow-details { padding: 23px; }.flow-details dl > div { grid-template-columns: 1fr; gap: 4px; }.flow-details h2 { font-size: 24px; }.flow-details dd { font-size: 16px; }
  }
  @media(prefers-reduced-motion:reduce) { .flow-node { transition: none; }.flow-node:hover { transform: none; } }
</style>
