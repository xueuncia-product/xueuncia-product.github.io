---
import '../styles/global.css';
import { SECTIONS } from '../sections';

interface Props { title?: string; description?: string; active?: string; privateEntry?: boolean; showVerse?: boolean; pageKind?: string }
const { title, description, active, showVerse = true, pageKind = active === 'works' ? 'showcase' : 'section' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = SECTIONS.find((s) => s.key === active);
const isSection = section && title === section.name;
const parent = section ? { name: section.name, href: `${base}/${section.key}/` } : { name: '首页', href: `${base}/` };
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · 雪豹 Uncia` : '雪豹 Uncia'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="stylesheet" href={`${base}/fonts/fonts.css?v=redesign-20261010`} />
    <link rel="stylesheet" href={`${base}/themes/scenes.css?v=redesign-20261010`} />
    <link rel="stylesheet" href={`${base}/themes/typography.css?v=redesign-20261010`} />
    <link rel="stylesheet" href={`${base}/shell.css?v=redesign-20261010-2`} />
    <link rel="stylesheet" href={`${base}/companion.css?v=redesign-20261010`} />
    <script is:inline type="module" src={`${base}/themes/scenes.js?v=redesign-20261010`}></script>
    <script is:inline type="module" src={`${base}/site.js?v=redesign-20261010`}></script>
    <script is:inline type="module" src={`${base}/companion.js?v=redesign-20261010`}></script>
    <link rel="icon" href={`${base}/leo_sit.webp`} type="image/webp" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        const themes = ['sky', 'cosmos', 'ink'], queryTheme = new URLSearchParams(location.search).get('theme');
        if (themes.includes(queryTheme)) theme = queryTheme;
        if (!themes.includes(theme)) theme = 'sky';
        try { localStorage.setItem('theme', theme); } catch {}
        const paint = () => {
          const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Shanghai' }));
          const hour = now.getHours() + now.getMinutes() / 60;
          document.documentElement.classList.toggle('night', theme === 'cosmos' || (theme === 'sky' && (hour < 5.5 || hour >= 19.5)));
          document.documentElement.classList.toggle('cosmos', theme === 'cosmos');
          document.documentElement.classList.toggle('ink', theme === 'ink');
          document.querySelectorAll('[data-theme-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === theme)));
        };
        paint(); setInterval(paint, 60000);
        addEventListener('DOMContentLoaded', () => {
          paint();
          document.querySelectorAll('[data-theme-choice]').forEach((button) => button.addEventListener('click', () => {
            theme = button.dataset.themeChoice;
            try { localStorage.setItem('theme', theme); } catch {}
            paint();
          }));
        });
      })();
    </script>
  </head>
  <body data-page-kind={pageKind}>
    <div data-theme-scene aria-hidden="true"></div>
    <header class="wrap nav site-header">
      <a class="logo" href={`${base}/`} aria-label="雪豹 Uncia 首页">Uncia</a>
      <nav class="site-links desktop-links" aria-label="主导航"><ul>
        {SECTIONS.map((s) => (
          <li><a href={`${base}/${s.key}/`} aria-current={active === s.key ? 'page' : undefined}>{s.name}</a></li>
        ))}
        <li><a href={`${base}/old-days/`}>旧时光</a></li>
        <li><a href={`${base}/contact/`} aria-current={active === 'contact' ? 'page' : undefined}>联系</a></li>
      </ul></nav>
      <div class="theme-switch" aria-label="页面主题"><button type="button" data-theme-choice="sky" aria-pressed="true">☁ 云端</button><button type="button" data-theme-choice="cosmos" aria-pressed="false">☯ 太极</button><button type="button" data-theme-choice="ink" aria-pressed="false"><svg class="theme-icon" aria-hidden="true" viewBox="0 0 20 20"><path d="m13.5 2 4 4-8.7 8.7-4.6.6.6-4.6Z"/><path d="m11.5 4 4 4M3 17l3-.3"/></svg> 水墨</button></div>
      <details class="mobile-navigation"><summary aria-label="打开网站导航">菜单</summary><nav aria-label="移动导航">{SECTIONS.map((s) => <a href={`${base}/${s.key}/`} aria-current={active === s.key ? 'page' : undefined}>{s.name}</a>)}<a href={`${base}/old-days/`}>旧时光</a><a href={`${base}/about/`}>关于</a><a href={`${base}/contact/`}>联系</a></nav></details>
    </header>
    <div class="wrap page-toolbar"><nav class="breadcrumbs" aria-label="页面位置"><a href={`${base}/`}>首页</a>{section && !isSection && <><span aria-hidden="true">/</span><a href={parent.href}>{parent.name}</a></>}<span aria-hidden="true">/</span><span aria-current="page">{title || '关于'}</span></nav><a class="parent-link" href={isSection ? `${base}/` : parent.href}>← {isSection ? '回首页' : `回${parent.name}`}</a></div>
    {showVerse && <aside class="wrap page-motto" data-theme-verse data-compact></aside>}
    <main class="wrap"><slot /></main>
    <footer class="wrap footer">
      <span>© {new Date().getFullYear()} 雪豹 Uncia</span>
      <a href={`${base}/contact/`}>微信联系</a>
      <nav aria-label="页脚导航"><a href={`${base}/`}>首页</a><a href={`${base}/works/`}>作品</a><a href={`${base}/about/`}>关于</a><a href={`${base}/about/#fonts`}>字体声明</a><button type="button" data-back-to-top>回到顶部 ↑</button></nav>
    </footer>
  </body>
</html>
